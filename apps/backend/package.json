{
    "name": "aibill-backend",
    "version": "1.0.0",
    "description": "Core Backend Engine for AIBill Enterprise SaaS",
    "main": "dist/app.js",
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
        "clean": "rimraf dist",
        "build": "npm run clean && tsc",
        "start": "node dist/app.js",
        "db:migrate": "pnpm exec prisma migrate dev",
        "db:generate": "pnpm exec prisma generate",
        "db:seed": "pnpm exec prisma db seed"
    },
    "dependencies": {
        "@prisma/client": "^5.10.0",
        "bullmq": "^5.1.0",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.18.2",
        "ioredis": "^5.3.2",
        "openai": "^4.28.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/node": "^20.11.24",
        "prisma": "^5.10.0",
        "rimraf": "^5.0.5",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.3.3"
    }
}