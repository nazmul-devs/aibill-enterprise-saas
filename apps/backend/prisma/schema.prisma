datasource db {
    provider = "postgresql"
}

generator client {
    provider = "prisma-client-js"
}

model AdminUser {
    id       String @id @default(uuid())
    email    String @unique @db.VarChar(255)
    password String @db.VarChar(255)

    firstName String? @db.VarChar(100)
    lastName  String? @db.VarChar(100)

    role AdminRole @default(ADMIN)

    isActive Boolean @default(true)

    lastLoginAt DateTime?

    createdAt      DateTime        @default(now())
    updatedAt      DateTime        @updatedAt
    adminAuditLogs AdminAuditLog[]

    @@index([email])
    @@index([isActive])
}

enum AdminRole {
    SUPER_ADMIN
    ADMIN
    SUPPORT
}

model AdminAuditLog {
    id String @id @default(uuid())

    adminId String?
    admin   AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

    action String @db.VarChar(100)

    entity   String  @db.VarChar(100)
    entityId String? @db.VarChar(100)

    tenantId String?
    tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

    metadata Json?

    ipAddress String? @db.VarChar(100)
    userAgent String? @db.VarChar(500)

    createdAt DateTime @default(now())

    @@index([adminId])
    @@index([tenantId])
    @@index([entity, entityId])
    @@index([createdAt])
}

model Plan {
    id String @id @default(uuid())

    name String @unique @db.VarChar(100)
    slug String @unique @db.VarChar(100)

    description String? @db.VarChar(500)

    price    Decimal @db.Decimal(12, 2)
    currency String  @default("USD") @db.VarChar(10)

    billingCycle BillingCycle @default(MONTHLY)

    maxUsers    Int?
    maxInvoices Int?

    isActive Boolean @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    subscriptions Subscription[]

    @@index([isActive])
}

model Subscription {
    id String @id @default(uuid())

    tenantId String
    tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

    planId String

    plan Plan @relation(fields: [planId], references: [id])

    status SubscriptionStatus @default(TRIALING)

    startDate DateTime  @default(now())
    endDate   DateTime?

    trialEndsAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([tenantId])
    @@index([planId])
    @@index([status])
}

enum SubscriptionStatus {
    TRIALING
    ACTIVE
    PAST_DUE
    CANCELLED
    EXPIRED
}

enum BillingCycle {
    MONTHLY
    YEARLY
}

model Tenant {
    id   String @id @default(uuid())
    name String @db.VarChar(255)
    slug String @unique @db.VarChar(255)

    isActive Boolean @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    users          User[]
    invoices       Invoice[]
    ledgers        Ledger[]
    subscriptions  Subscription[]
    adminAuditLogs AdminAuditLog[]
    profile        TenantProfile?
    tenantSettings TenantSettings[]

    @@index([isActive])
}

model TenantProfile {
    id String @id @default(uuid())

    tenantId String @unique
    tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

    // -------------------------------------------------------------------------
    // Contact Information
    // -------------------------------------------------------------------------

    email  String? @db.VarChar(255)
    phone  String? @db.VarChar(30)
    mobile String? @db.VarChar(30)
    fax    String? @db.VarChar(30)

    // -------------------------------------------------------------------------
    // Website & Social Media
    // -------------------------------------------------------------------------

    website   String? @db.VarChar(255)
    facebook  String? @db.VarChar(255)
    instagram String? @db.VarChar(255)
    linkedin  String? @db.VarChar(255)
    twitter   String? @db.VarChar(255)
    youtube   String? @db.VarChar(255)

    // -------------------------------------------------------------------------
    // Address
    // -------------------------------------------------------------------------

    address    String? @db.VarChar(500)
    city       String? @db.VarChar(100)
    state      String? @db.VarChar(100)
    postalCode String? @db.VarChar(20)
    country    String? @db.VarChar(100)

    // -------------------------------------------------------------------------
    // Business Information
    // -------------------------------------------------------------------------

    businessName       String? @db.VarChar(255)
    taxNumber          String? @db.VarChar(100)
    registrationNumber String? @db.VarChar(100)

    // -------------------------------------------------------------------------
    // Branding
    // -------------------------------------------------------------------------

    logo String? @db.VarChar(500)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model TenantSettings {
    id String @id @default(uuid())

    tenantId String @unique
    tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

    currency   String @default("USD") @db.VarChar(10)
    timezone   String @default("UTC") @db.VarChar(50)
    dateFormat String @default("YYYY-MM-DD") @db.VarChar(30)

    invoicePrefix     String @default("INV") @db.VarChar(20)
    invoiceNextNumber Int    @default(1)

    paymentTermsDays Int @default(30)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model User {
    id        String   @id @default(uuid())
    tenantId  String
    tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    email     String   @db.VarChar(255)
    password  String   @db.VarChar(255)
    firstName String?  @db.VarChar(100)
    lastName  String?  @db.VarChar(100)
    isActive  Boolean  @default(true)
    roleId    String
    role      Role     @relation(fields: [roleId], references: [id])
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([tenantId, email])
    @@index([tenantId])
}

model Role {
    id          String           @id @default(uuid())
    name        String           @unique @db.VarChar(100)
    description String?          @db.VarChar(255)
    createdAt   DateTime         @default(now())
    updatedAt   DateTime         @updatedAt
    users       User[]
    permissions RolePermission[]
}

model Permission {
    id        String           @id @default(uuid())
    action    String           @unique @db.VarChar(100) // e.g., "invoice:create", "report:view"
    module    String           @db.VarChar(100) // e.g., "Invoices", "Accounting"
    createdAt DateTime         @default(now())
    roles     RolePermission[]
}

// Junction Table for Many-to-Many Relation between Roles and Permissions
model RolePermission {
    roleId       String
    role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
    permissionId String
    permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

    @@id([roleId, permissionId])
}

model Invoice {
    id          String       @id @default(uuid())
    tenantId    String
    tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    invoiceNo   String       @db.VarChar(100)
    amount      Decimal      @db.Decimal(12, 2) // Guard against floating point binary inaccuracies
    tax         Decimal      @db.Decimal(12, 2)
    status      String       @default("PENDING") @db.VarChar(50) // PENDING, PAID, VOID
    issuedAt    DateTime     @default(now())
    createdAt   DateTime     @default(now())
    updatedAt   DateTime     @updatedAt
    auditResult AuditResult?

    @@unique([tenantId, invoiceNo])
    @@index([tenantId, status])
}

model Ledger {
    id          String   @id @default(uuid())
    tenantId    String
    tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    accountName String   @db.VarChar(100) // e.g., "Accounts Receivable", "Revenue", "Tax Output"
    debit       Decimal  @db.Decimal(12, 2)
    credit      Decimal  @db.Decimal(12, 2)
    reference   String?  @db.VarChar(255) // Reference to Invoice ID or Void Token
    createdAt   DateTime @default(now())

    @@index([tenantId, createdAt])
}

model AuditResult {
    id         String   @id @default(uuid())
    invoiceId  String   @unique
    invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
    riskScore  Int // Range 0 - 100 calculated by OpenAI Engine
    riskStatus String   @db.VarChar(50) // LOW, MEDIUM, HIGH
    analysis   String   @db.Text
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@index([riskStatus])
}
