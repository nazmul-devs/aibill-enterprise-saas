# =========================================================================
# AIBill-Core Monorepo Git Ignore Rules
# =========================================================================

# Dependency Directories
node_modules/
/node_modules
*/node_modules/
apps/*/node_modules/

# TypeScript & Build Outputs
dist/
/dist
apps/backend/dist/
build/
.cache/

# Next.js & React Build Outputs
apps/tenant-portal/.next/
apps/tenant-portal/out/
apps/saas-admin/dist/
apps/saas-admin/build/

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
apps/backend/.env

# Debug & Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# IDEs and Editors Configuration
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# Operating System Files
.DS_Store
Thumbs.db

# Prisma ORM Artifacts
/apps/backend/prisma/*.db
/apps/backend/prisma/*.db-journal

# Docker Context Specifics
.dockerignore
